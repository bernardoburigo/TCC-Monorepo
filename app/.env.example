# URL base da API. Copie para `.env.local` (ignorado pelo git) e ajuste se precisar.
# - Web (expo start --web) no mesmo PC do backend: http://localhost:8080
# - Celular/Expo Go: use o IP do PC na rede local, ex.: http://192.168.0.10:8080
#   (e libere as portas 8080 e 8081 no firewall do PC)
EXPO_PUBLIC_API_URL=http://localhost:8080

# true = ignora a API/backend e usa dados fictícios gerados em src/api/mock/ (ver README,
# seção "Visualizar sem backend (dados mock)"). Recurso isolado e fácil de remover: não
# precisa disto para rodar contra o backend real.
EXPO_PUBLIC_USE_MOCK_DATA=false
